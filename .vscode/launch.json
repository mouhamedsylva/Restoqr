{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web (HTML renderer)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "--web-renderer",
        "html"
      ]
    },
    {
      "name": "Flutter Chrome (HTML renderer)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-renderer",
        "html"
      ]
    }
  ]
}
